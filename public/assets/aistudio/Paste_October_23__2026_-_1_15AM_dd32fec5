            background: rgba(17, 24, 39, 0.85);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
</head>
<body class="bg-gray-950 text-gray-100 h-screen w-screen overflow-hidden flex flex-col md:flex-row">

    <!-- LEFT / TOP: 3D WebGL Viewport Container -->
    <div class="relative w-full md:w-2/3 lg:w-3/4 h-1/2 md:h-full bg-black flex-1" id="canvas-container">
        <!-- 3D Canvas will be injected here -->
        
