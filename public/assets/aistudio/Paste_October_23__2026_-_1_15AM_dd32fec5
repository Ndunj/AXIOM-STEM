    <!-- MAIN JAVASCRIPT LOGIC -->
    <script>
        // --- STATE MANAGEMENT ---
        const state = {
            mode: 'demo', // 'demo' or 'inquiry'
            sourceType: 'unpolarized', // 'unpolarized', 'linear', 'circular'
            sourceAngle: 0, // degrees
            frequency: 0.8,
            amplitude: 1.2,
            
            // Filter configurations
            f1Enabled: true,
            f1Angle: 0, // degrees
            
            f2Enabled: false,
            f2Angle: 45, // degrees
            
            f3Enabled: true,
            f3Angle: 90, // degrees

            // Render options
            showBField: false,
            showVectors: true,
            showGrid: true,
            isPlaying: true,

            // Calculated Intensities (Relative to I0 = 1.0)
            I0: 1.0,
            I1: 0.5,
            I2: 0.25,
            I3: 0.0,

            // Inquiry Challenge State
            challengeStep: 1,
            targetIntensity: 0.25
        };

        // --- THREE.JS GLOBALS ---
        let scene, camera, renderer, controls;
        let waveGroup, filtersGroup, gridHelper;
        let eFieldLines = [], bFieldLines = [], vectorArrows = [];
        let filterMeshes = [];
        let clock = new THREE.Clock();
        let animationTime = 0;

        // Colors
        const COLOR_EFIELD = 0x22d3ee; // Cyan
        const COLOR_BFIELD = 0x3b82f6; // Blue
        const COLOR_ABSORBED = 0xf87171; // Red
        const COLOR_AXIS = 0xf59e0b; // Amber

        // Initialize Application
        window.addEventListener('DOMContentLoaded', () => {
            initThreeJS();
            buildSceneObjects();
            setupUIEventListeners();
            updateCalculationsAndUI();
            animate();
        });

        // --- THREE.JS INITIALIZATION ---
        function initThreeJS() {
            const container = document.getElementById('canvas-container');
            
            // Scene
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x030712); // Gray 950

            // Camera
            camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
            camera.position.set(6, 4, 9);

            // Renderer
            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(container.clientWidth, container.clientHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.shadowMap.enabled = true;
            container.appendChild(renderer.domElement);

            // Orbit Controls
            controls = new THREE.OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.dampingFactor = 0.05;
            controls.maxDistance = 25;
            controls.minDistance = 2;

            // Lighting
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
            scene.add(ambientLight);

            const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
            dirLight.position.set(10, 15, 10);
            scene.add(dirLight);

            // Axis & Grid Helpers
            gridHelper = new THREE.GridHelper(20, 20, 0x374151, 0x1f2937);
            gridHelper.position.y = -2.5;
            scene.add(gridHelper);

            // Direction Arrow (X-axis Propagation)
            const dirArrow = new THREE.ArrowHelper(
                new THREE.Vector3(1, 0, 0),
                new THREE.Vector3(-6, -2.4, 0),
                12,
                0x6b7280,
                0.4,
                0.3
            );
            scene.add(dirArrow);

            // Groups
            waveGroup = new THREE.Group();
            filtersGroup = new THREE.Group();
            scene.add(waveGroup);
            scene.add(filtersGroup);

            // Resize Handler
            window.addEventListener('resize', onWindowResize);
        }

        // --- SCENE BUILDER ---
        function buildSceneObjects() {
            createFilterDisks();
            updateWaveGeometry();
        }

        // Create 3D Translucent Polarizer Disks
        function createFilterDisks() {
            // Clear existing
            filterMeshes.forEach(m => filtersGroup.remove(m));
            filterMeshes = [];

            const filterPositions = [
                { id: 1, x: -2, angle: state.f1Angle, enabled: state.f1Enabled, color: 0x6366f1 }, // Indigo
                { id: 2, x: 0, angle: state.f2Angle, enabled: state.f2Enabled, color: 0x10b981 },  // Emerald
                { id: 3, x: 2, angle: state.f3Angle, enabled: state.f3Enabled, color: 0xa855f7 }   // Purple
            ];

            filterPositions.forEach(f => {
                const group = new THREE.Group();
                group.position.x = f.x;

                if (f.enabled) {
                    // Disk Ring Frame
                    const ringGeo = new THREE.TorusGeometry(1.8, 0.06, 16, 64);
                    const ringMat = new THREE.MeshStandardMaterial({ color: 0x374151, metalness: 0.8, roughness: 0.2 });
                    const ring = new THREE.Mesh(ringGeo, ringMat);
                    ring.rotation.y = Math.PI / 2;
                    group.add(ring);

                    // Translucent Glass Filter Area
                    const glassGeo = new THREE.CylinderGeometry(1.8, 1.8, 0.04, 64);
                    const glassMat = new THREE.MeshPhysicalMaterial({
                        color: f.color,
                        transparent: true,
                        opacity: 0.35,
                        roughness: 0.1,
                        transmission: 0.6,
                        thickness: 0.5
                    });
                    const glass = new THREE.Mesh(glassGeo, glassMat);
                    glass.rotation.z = Math.PI / 2;
                    group.add(glass);

                    // Optical Axis Line (Transmission Axis Marker)
                    const axisGroup = new THREE.Group();
                    const lineGeo = new THREE.CylinderGeometry(0.03, 0.03, 3.5, 16);
                    const lineMat = new THREE.MeshBasicMaterial({ color: COLOR_AXIS });
                    const axisLine = new THREE.Mesh(lineGeo, lineMat);
                    axisGroup.add(axisLine);

                    // Axis Tip Arrows
                    const arrowTop = new THREE.Mesh(new THREE.ConeGeometry(0.08, 0.2, 16), lineMat);
                    arrowTop.position.y = 1.75;
                    const arrowBottom = new THREE.Mesh(new THREE.ConeGeometry(0.08, 0.2, 16), lineMat);
                    arrowBottom.position.y = -1.75;
                    arrowBottom.rotation.z = Math.PI;
                    axisGroup.add(arrowTop);
                    axisGroup.add(arrowBottom);

                    // Rotate optical axis according to angle
                    axisGroup.rotation.x = THREE.MathUtils.degToRad(f.angle);
                    group.add(axisGroup);

                    // Label Tag
                    group.userData = { id: f.id, angle: f.angle, axisGroup: axisGroup };
                }

                filtersGroup.add(group);
                filterMeshes.push(group);
            });
        }

        // Dynamically compute wave components along X-axis
        function updateWaveGeometry() {
            // Remove old meshes in waveGroup
            while(waveGroup.children.length > 0){ 
                const obj = waveGroup.children[0];
                waveGroup.remove(obj); 
            }

            const xStart = -5.5;
            const xEnd = 5.5;
            const step = 0.08;
            const pointsCount = Math.floor((xEnd - xStart) / step);

            // Pre-allocate geometry points
            const ePoints = [];
            const bPoints = [];

            let currentPolarization = state.sourceType; // 'unpolarized', 'linear', 'circular'
            let currentAngle = THREE.MathUtils.degToRad(state.sourceAngle); // radians
            let currentAmp = state.amplitude;

            for (let i = 0; i <= pointsCount; i++) {
                const x = xStart + i * step;

                // Check filter boundaries and apply transformations
                if (state.f1Enabled && x >= -2.0) {
                    const f1Rad = THREE.MathUtils.degToRad(state.f1Angle);
                    if (currentPolarization === 'unpolarized') {
                        currentPolarization = 'linear';
                        currentAngle = f1Rad;
                        currentAmp = state.amplitude * Math.sqrt(state.I1);
                    } else if (currentPolarization === 'linear') {
                        const dTh = f1Rad - currentAngle;
                        currentAmp = currentAmp * Math.abs(Math.cos(dTh));
                        currentAngle = f1Rad;
                    }
                }

                if (state.f2Enabled && x >= 0.0) {
                    const f2Rad = THREE.MathUtils.degToRad(state.f2Angle);
                    const dTh = f2Rad - currentAngle;
                    currentAmp = currentAmp * Math.abs(Math.cos(dTh));
                    currentAngle = f2Rad;
                }

                if (state.f3Enabled && x >= 2.0) {
                    const f3Rad = THREE.MathUtils.degToRad(state.f3Angle);
                    const dTh = f3Rad - currentAngle;
                    currentAmp = currentAmp * Math.abs(Math.cos(dTh));
                    currentAngle = f3Rad;
                }

                // Compute wave phase
                const k = 2.0; // Wave number
                const omega = state.frequency * 4.0;
                const phase = k * x - animationTime * omega;

                let ey = 0, ez = 0;

                if (currentPolarization === 'unpolarized' && x < -2.0) {
                    // Unpolarized: Superposition/rapidly changing vector angle based on position & time
                    const randAngle = Math.sin(x * 5.0 + animationTime * 3.0) * Math.PI;
                    ey = currentAmp * Math.cos(phase) * Math.cos(randAngle);
                    ez = currentAmp * Math.cos(phase) * Math.sin(randAngle);
                } else if (currentPolarization === 'circular') {
                    // Circular Polarization: Phase shift between Y and Z components
                    ey = currentAmp * Math.cos(phase);
                    ez = currentAmp * Math.sin(phase);
                } else {
                    // Linearly Polarized at currentAngle
                    const waveVal = currentAmp * Math.cos(phase);
                    ey = waveVal * Math.cos(currentAngle);
                    ez = waveVal * Math.sin(currentAngle);
                }

                ePoints.push(new THREE.Vector3(x, ey, ez));

                // B-Field is perpendicular to E-Field
                if (state.showBField) {
                    bPoints.push(new THREE.Vector3(x, -ez, ey));
                }

                // Render Vector Field Arrows at discrete steps
                if (state.showVectors && i % 3 === 0 && Math.abs(ey) + Math.abs(ez) > 0.05) {
                    // Electric Field Arrow
                    const eDir = new THREE.Vector3(0, ey, ez).normalize();
                    const eLen = Math.sqrt(ey * ey + ez * ez);
                    const arrowE = new THREE.ArrowHelper(eDir, new THREE.Vector3(x, 0, 0), eLen, COLOR_EFIELD, 0.15, 0.1);
                    waveGroup.add(arrowE);

                    // Optional Magnetic Field Arrow
                    if (state.showBField) {
                        const bDir = new THREE.Vector3(0, -ez, ey).normalize();
                        const bLen = eLen;
                        const arrowB = new THREE.ArrowHelper(bDir, new THREE.Vector3(x, 0, 0), bLen, COLOR_BFIELD, 0.12, 0.08);
                        waveGroup.add(arrowB);
                    }
                }
            }

            // Continuous Wave Line (E-Field)
            if (ePoints.length > 1) {
                const eGeo = new THREE.BufferGeometry().setFromPoints(ePoints);
                const eMat = new THREE.LineBasicMaterial({ color: COLOR_EFIELD, linewidth: 2 });
                const eLine = new THREE.Line(eGeo, eMat);
                waveGroup.add(eLine);
            }

            // Continuous Wave Line (B-Field)
            if (state.showBField && bPoints.length > 1) {
                const bGeo = new THREE.BufferGeometry().setFromPoints(bPoints);
                const bMat = new THREE.LineBasicMaterial({ color: COLOR_BFIELD, linewidth: 1.5 });
                const bLine = new THREE.Line(bGeo, bMat);
                waveGroup.add(bLine);
            }
        }

        // --- CALCULATIONS & UI SYNCHRONIZATION ---
        function updateCalculationsAndUI() {
            // 1. Calculate Intensity progression based on Malus's Law
            state.I0 = 1.0; // Normalized 100%

            // Stage 1: Filter 1
            if (state.sourceType === 'unpolarized') {
                state.I1 = 0.5; // Natural unpolarized light through linear filter drops to 50%
            } else if (state.sourceType === 'circular') {
                state.I1 = 0.5;
            } else {
                // Linearly polarized input
                const dTh1 = THREE.MathUtils.degToRad(state.f1Angle - state.sourceAngle);
                state.I1 = Math.pow(Math.cos(dTh1), 2);
            }

            // Stage 2: Middle Filter (Optional)
            if (state.f2Enabled) {
                const dTh2 = THREE.MathUtils.degToRad(state.f2Angle - state.f1Angle);
                state.I2 = state.I1 * Math.pow(Math.cos(dTh2), 2);
            } else {
                state.I2 = state.I1;
            }

            // Stage 3: Analyzer Filter
            const lastAngle = state.f2Enabled ? state.f2Angle : state.f1Angle;
            const dTh3 = THREE.MathUtils.degToRad(state.f3Angle - lastAngle);
            state.I3 = state.I2 * Math.pow(Math.cos(dTh3), 2);

            // 2. Update Meters UI
            const pct = (val) => (val * 100).toFixed(1) + '%';
            
            document.getElementById('meter-i0-bar').style.width = '100%';
            document.getElementById('meter-i1-bar').style.width = (state.I1 * 100) + '%';
            document.getElementById('meter-i1-text').innerText = pct(state.I1);

            const i2Container = document.getElementById('meter-i2-container');
            if (state.f2Enabled) {
                i2Container.classList.remove('hidden');
                document.getElementById('meter-i2-bar').style.width = (state.I2 * 100) + '%';
                document.getElementById('meter-i2-text').innerText = pct(state.I2);
            } else {
                i2Container.classList.add('hidden');
            }

            document.getElementById('meter-i3-bar').style.width = (state.I3 * 100) + '%';
            document.getElementById('meter-i3-text').innerText = pct(state.I3);

            // 3. Update Formula Readouts
            const f1A = state.f1Angle, f2A = state.f2Angle, f3A = state.f3Angle;
            document.getElementById('math-formula-step1').innerText = state.sourceType === 'unpolarized' 
                ? `I₁ = ½ I₀ = 50.0%`
                : `I₁ = I₀ × cos²(${Math.abs(f1A - state.sourceAngle)}°) = ${pct(state.I1)}`;

            if (state.f2Enabled) {
                document.getElementById('math-formula-step2').innerText = 
                    `I_mid = I₁ × cos²(${Math.abs(f2A - f1A)}°) = ${pct(state.I2)} | I_final = ${pct(state.I3)}`;
            } else {
                document.getElementById('math-formula-step2').innerText = 
                    `I_final = I₁ × cos²(${Math.abs(f3A - f1A)}°) = ${pct(state.I3)}`;
            }

            // 4. Update Badge & Text Insights
            const badge = document.getElementById('current-state-badge');
            if (state.I3 < 0.001) {
                badge.innerText = "State: Total Extinction (0%)";
                badge.className = "px-3 py-1 text-xs font-semibold rounded-full bg-red-900/80 text-red-200 border border-red-500/30 shadow-lg";
            } else {
                badge.innerText = `State: Transmitting (${pct(state.I3)})`;
                badge.className = "px-3 py-1 text-xs font-semibold rounded-full bg-emerald-900/80 text-emerald-200 border border-emerald-500/30 shadow-lg";
            }

            // 5. Inquiry Challenge Verification Update
            if (state.mode === 'inquiry') {
                document.getElementById('current-val').innerText = pct(state.I3);
            }

            // 6. Refresh 3D Filter Meshes Rotations
            createFilterDisks();
        }

        // --- EVENT LISTENERS & INTERACTION ---
        function setupUIEventListeners() {
            // Mode Toggle
            document.getElementById('mode-demo').addEventListener('click', () => setMode('demo'));
            document.getElementById('mode-inquiry').addEventListener('click', () => setMode('inquiry'));

            // Viewport Controls
            document.getElementById('btn-reset-cam').addEventListener('click', () => {
                camera.position.set(6, 4, 9);
                controls.target.set(0, 0, 0);
                controls.update();
            });

            const playPauseBtn = document.getElementById('btn-play-pause');
            playPauseBtn.addEventListener('click', () => {
                state.isPlaying = !state.isPlaying;
                document.getElementById('play-pause-icon').className = state.isPlaying ? "fa-solid fa-pause" : "fa-solid fa-play";
                document.getElementById('play-pause-text').innerText = state.isPlaying ? "Pause" : "Play";
            });

            document.getElementById('chk-bfield').addEventListener('change', (e) => {
                state.showBField = e.target.checked;
            });

            document.getElementById('chk-vectors').addEventListener('change', (e) => {
                state.showVectors = e.target.checked;
            });

            document.getElementById('chk-grid').addEventListener('change', (e) => {
                gridHelper.visible = e.target.checked;
            });

            // Sliders & Selects
            const sourceTypeSel = document.getElementById('source-type-select');
            const sourceAngleContainer = document.getElementById('source-angle-container');
            
            sourceTypeSel.addEventListener('change', (e) => {
                state.sourceType = e.target.value;
                sourceAngleContainer.style.display = state.sourceType === 'linear' ? 'block' : 'none';
                updateCalculationsAndUI();
            });

            document.getElementById('slider-source-angle').addEventListener('input', (e) => {
                state.sourceAngle = parseInt(e.target.value);
                document.getElementById('source-angle-val').innerText = state.sourceAngle + '°';
                updateCalculationsAndUI();
            });

            document.getElementById('slider-freq').addEventListener('input', (e) => state.frequency = parseFloat(e.target.value));
            document.getElementById('slider-amp').addEventListener('input', (e) => state.amplitude = parseFloat(e.target.value));

            // Filters Sliders
            document.getElementById('slider-f1-angle').addEventListener('input', (e) => {
                state.f1Angle = parseInt(e.target.value);
                document.getElementById('f1-angle-val').innerText = state.f1Angle + '°';
                updateCalculationsAndUI();
            });

            const f2Check = document.getElementById('chk-f2-enable');
            const f2Slider = document.getElementById('slider-f2-angle');
            f2Check.addEventListener('change', (e) => {
                state.f2Enabled = e.target.checked;
                f2Slider.disabled = !state.f2Enabled;
                f2Slider.className = state.f2Enabled 
                    ? "w-full h-1.5 bg-gray-700 rounded-lg appearance-none cursor-pointer accent-emerald-500" 
                    : "w-full h-1.5 bg-gray-800 rounded-lg appearance-none cursor-pointer accent-emerald-500 opacity-50";
                updateCalculationsAndUI();
            });

            f2Slider.addEventListener('input', (e) => {
                state.f2Angle = parseInt(e.target.value);
                document.getElementById('f2-angle-val').innerText = state.f2Angle + '°';
                updateCalculationsAndUI();
            });

            document.getElementById('slider-f3-angle').addEventListener('input', (e) => {
                state.f3Angle = parseInt(e.target.value);
                document.getElementById('f3-angle-val').innerText = state.f3Angle + '°';
                updateCalculationsAndUI();
            });

            // Presets Buttons
            document.querySelectorAll('.preset-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const preset = btn.getAttribute('data-preset');
                    applyPreset(preset);
                });
            });

            // Inquiry Challenge Check
            document.getElementById('btn-check-task').addEventListener('click', checkInquiryAnswer);
        }

        // Apply Pedagogical Presets
        function applyPreset(preset) {
            if (preset === 'unpolarized') {
                state.sourceType = 'unpolarized';
                state.f1Angle = 0;
                state.f2Enabled = false;
                state.f3Angle = 0;
            } else if (preset === 'malus') {
                state.sourceType = 'unpolarized';
                state.f1Angle = 0;
                state.f2Enabled = false;
                state.f3Angle = 45;
            } else if (preset === 'crossed') {
                state.sourceType = 'unpolarized';
                state.f1Angle = 0;
                state.f2Enabled = false;
                state.f3Angle = 90;
            } else if (preset === 'three-filters') {
                state.sourceType = 'unpolarized';
                state.f1Angle = 0;
                state.f2Enabled = true;
                state.f2Angle = 45;
                state.f3Angle = 90;
            } else if (preset === 'circular') {
                state.sourceType = 'circular';
                state.f1Angle = 0;
                state.f2Enabled = false;
                state.f3Angle = 0;
            }

            // Sync Controls Controls DOM
            document.getElementById('source-type-select').value = state.sourceType;
            document.getElementById('source-angle-container').style.display = state.sourceType === 'linear' ? 'block' : 'none';
            document.getElementById('slider-f1-angle').value = state.f1Angle;
            document.getElementById('f1-angle-val').innerText = state.f1Angle + '°';
            
            document.getElementById('chk-f2-enable').checked = state.f2Enabled;
            const f2Slider = document.getElementById('slider-f2-angle');
            f2Slider.disabled = !state.f2Enabled;
            f2Slider.value = state.f2Angle;
            document.getElementById('f2-angle-val').innerText = state.f2Angle + '°';

            document.getElementById('slider-f3-angle').value = state.f3Angle;
            document.getElementById('f3-angle-val').innerText = state.f3Angle + '°';

            updateCalculationsAndUI();
        }

        // Mode Switcher Logic
        function setMode(mode) {
            state.mode = mode;
            const demoBtn = document.getElementById('mode-demo');
            const inquiryBtn = document.getElementById('mode-inquiry');
            const demoPanel = document.getElementById('panel-demo');
            const inquiryPanel = document.getElementById('panel-inquiry');

            if (mode === 'demo') {
                demoBtn.className = "py-1.5 text-xs font-semibold rounded-lg bg-indigo-600 text-white transition flex items-center justify-center gap-1 shadow";
                inquiryBtn.className = "py-1.5 text-xs font-semibold rounded-lg text-gray-400 hover:text-gray-200 transition flex items-center justify-center gap-1";
                demoPanel.classList.remove('hidden');
                inquiryPanel.classList.add('hidden');
            } else {
                inquiryBtn.className = "py-1.5 text-xs font-semibold rounded-lg bg-indigo-600 text-white transition flex items-center justify-center gap-1 shadow";
                demoBtn.className = "py-1.5 text-xs font-semibold rounded-lg text-gray-400 hover:text-gray-200 transition flex items-center justify-center gap-1";
                inquiryPanel.classList.remove('hidden');
                demoPanel.classList.add('hidden');
            }
        }

        // Inquiry Answer Checking
        function checkInquiryAnswer() {
            const feedback = document.getElementById('task-feedback');
            feedback.classList.remove('hidden', 'bg-emerald-950', 'text-emerald-300', 'bg-red-950', 'text-red-300');

            const currentI3Pct = state.I3 * 100;
            const targetPct = state.targetIntensity * 100;

            if (Math.abs(currentI3Pct - targetPct) < 1.5) {
                feedback.classList.add('bg-emerald-950', 'text-emerald-300', 'border', 'border-emerald-800');
                feedback.innerText = "🎉 Excellent! You found the correct orientation angle satisfying Malus's Law!";
            } else {
                feedback.classList.add('bg-red-950', 'text-red-300', 'border', 'border-red-800');
                feedback.innerText = `❌ Not quite. Current intensity is ${currentI3Pct.toFixed(1)}%, but target is ${targetPct.toFixed(1)}%. Try rotating Filter 3.`;
            }
        }

        // Window Resize Handler
        function onWindowResize() {
            const container = document.getElementById('canvas-container');
            camera.aspect = container.clientWidth / container.clientHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(container.clientWidth, container.clientHeight);
        }

        // --- MAIN ANIMATION LOOP ---
        function animate() {
            requestAnimationFrame(animate);

            if (state.isPlaying) {
                animationTime += clock.getDelta();
            } else {
                clock.getDelta(); // keep clock delta updated
            }

            // Re-render dynamic wave geometries
            updateWaveGeometry();

            // Update Orbit Controls
            controls.update();

            // Render 3D Scene
            renderer.render(scene, camera);
        }
    </script>
</body>
