        <div class="p-4 space-y-6 flex-1">

            <!-- DEMO MODE PANEL -->
            <div id="panel-demo" class="space-y-5">
                <!-- Preset Buttons -->
                <div>
                    <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-2">Preset Experiments</label>
                    <div class="grid grid-cols-2 gap-2 text-xs">
                        <button class="preset-btn bg-gray-800 hover:bg-gray-700 text-gray-200 p-2 rounded-lg border border-gray-700 text-left transition flex flex-col gap-0.5" data-preset="unpolarized">
