                    <div id="task-feedback" class="text-center font-medium text-xs hidden p-1.5 rounded"></div>
                </div>

                <!-- Guided Questions -->
                <div class="glass-panel p-3 rounded-xl space-y-2">
                    <div class="text-xs font-semibold text-gray-300">Quick Knowledge Checks</div>
                    <details class="text-xs group bg-gray-950/60 rounded-lg p-2 border border-gray-800">
                        <summary class="font-medium text-cyan-300 cursor-pointer flex justify-between items-center">
                            <span>What happens when Δθ = 90ͦ ?</span>
                            <i class="fa-solid fa-chevron-down text-[10px] group-open:rotate-180 transition"></i>
                        </summary>
                        <p class="mt-2 text-gray-400 text-[11px] leading-relaxed">
                            When transmission axes are perpendicular (\cos 90^\circ = 0), no electric field component can pass through, resulting in total light extinction (I = 0).
                        </p>
                    </details>
                    <details class="text-xs group bg-gray-950/60 rounded-lg p-2 border border-gray-800">
                        <summary class="font-medium text-cyan-300 cursor-pointer flex justify-between items-center">
                            <span>Why does 3rd filter add light back?</span>
                            <i class="fa-solid fa-chevron-down text-[10px] group-open:rotate-180 transition"></i>
                        </summary>
                        <p class="mt-2 text-gray-400 text-[11px] leading-relaxed">
                            The middle filter at 45° re-project the E-field vector onto a diagonal axis. This new diagonal vector now has a non-zero projection component onto the final 90° analyzer!
                        </p>
                    </details>
                </div>
            </div>

            <!-- MALUS'S LAW QUANTITATIVE METERS (SHARED) -->
            <div class="glass-panel p-3 rounded-xl space-y-3">
                <div class="text-xs font-semibold text-gray-300 flex items-center justify-between border-b border-gray-800 pb-1.5">
                    <span class="flex items-center gap-1.5"><i class="fa-solid fa-square-root-variable text-indigo-400"></i> Malus's Law & Intensity</span>
                    <span class="text-[10px] font-mono text-gray-400">I = I₀ · cos²(Δθ)</span>
                </div>

                <!-- Animated Intensity Bars -->
                <div class="space-y-2 text-xs">
                    <div>
