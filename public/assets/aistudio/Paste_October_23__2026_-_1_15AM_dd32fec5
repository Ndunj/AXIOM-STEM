                    <!-- Filter 1 -->
                    <div class="space-y-1 border-b border-gray-800 pb-2">
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-gray-300 font-medium">Filter 1 (θ_1) at x = -2</span>
                            <span id="f1-angle-val" class="font-mono text-indigo-400 font-bold">0°</span>
                        </div>
